{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo static-site-no-build",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/", "destination": "/app/index.html" }
  ],
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    },
    "api/health.js": {
      "maxDuration": 10
    }
  }
}
