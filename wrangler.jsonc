{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "luniversdamour",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
