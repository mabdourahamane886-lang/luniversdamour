# Gemini is the primary AI provider for L'univers d'amour.
# Add the real key only in Vercel Environment Variables, never in GitHub.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Backward-compatible aliases used by the provider factory.
AI_PRIMARY_API_KEY=your_gemini_api_key_here
AI_PRIMARY_MODEL=gemini-3.8-flash

# Optional secondary provider.
AI_SECONDARY_API_KEY=your_openai_api_key_here
AI_SECONDARY_MODEL=gpt-4o-mini

AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=900
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
