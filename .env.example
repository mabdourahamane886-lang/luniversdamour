# Amour AI Core is built into the application and does not require an external AI key.
# Modes: local, hybrid, compat, gemini. Default: hybrid.
AMOUR_AI_MODE=hybrid

# Recommended optional open-source generative engine via Hugging Face Inference Providers.
# The endpoint is OpenAI-compatible; Gemini is not required.
HF_TOKEN=your_huggingface_token_here
AI_COMPAT_API_KEY=your_huggingface_token_here
AI_COMPAT_BASE_URL=https://router.huggingface.co/v1
AI_COMPAT_MODEL=openai/gpt-oss-120b:fastest

# Optional Gemini provider. Gemini is NOT required for Amour AI Core.
AI_PRIMARY_API_KEY=your_gemini_api_key_here
AI_PRIMARY_MODEL=gemini-3.8-flash
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Optional secondary compatible provider aliases.
AI_SECONDARY_API_KEY=your_compatible_api_key_here
AI_SECONDARY_MODEL=openai/gpt-oss-120b:fastest
OPENAI_API_KEY=your_compatible_api_key_here

AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=900

# Current Supabase project used by L'univers d'amour.
SUPABASE_URL=https://okdohokhlkxrmxpevees.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_key_here
# Server-only secret. Never expose it to the browser and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
